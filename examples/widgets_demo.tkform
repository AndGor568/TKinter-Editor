{
  "version": 3,
  "form": {
    "title": "Демо: виджеты, функции, события",
    "width": 760,
    "height": 560,
    "bg": "#f3f4f6",
    "code_global": "import random\n\n\ndef random_color():\n    \"\"\"Случайный цвет #rrggbb.\"\"\"\n    return \"#%06x\" % random.randint(0, 0xFFFFFF)\n",
    "on_start": "set_items(\"list1\", names)\nprint(\"Старт:\", now())\n",
    "on_close": "print(\"Окно закрыто, очков:\", score)\n",
    "on_key": "if event.keysym == \"Escape\":\n    quit_app()\nelif event.keysym == \"space\":\n    add_score(1)\n",
    "timer_ms": 1000,
    "on_timer": "set_text(\"clock\", now())\n"
  },
  "variables": [
    {
      "name": "score",
      "type": "int",
      "value": 0
    },
    {
      "name": "names",
      "type": "list",
      "value": [
        "Аня",
        "Борис",
        "Вера"
      ]
    }
  ],
  "functions": [
    {
      "name": "add_score",
      "params": "points=1",
      "code": "global score\nscore += points\nset_value(\"progress1\", min(score, 100))\nreturn score\n"
    },
    {
      "name": "greet",
      "params": "who",
      "code": "return \"Привет, \" + who + \"! (\" + now(\"%H:%M\") + \")\"\n"
    }
  ],
  "items": [
    {
